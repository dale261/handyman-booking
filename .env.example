# Copy this file to .env.local and fill in the keys you have.
# The app runs with none of them. Missing keys use the fallbacks described in the README.

# Supabase. All three are required before the app uses the database instead of a local file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where customers open the site. PayPal sends them back here after payment.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Sample one-click sign-in. Leave this unset on Vercel and any public site.
# It is already off when NODE_ENV=production or when the three Supabase keys above are set.
# Set DEMO_MODE=true only if you intentionally want the sample buttons.
DEMO_MODE=

# Optional. If this matches a person's signup email, that person becomes the owner.
# You can also set it in the Supabase app_settings row before the first signup.
OWNER_EMAIL=

# Resend. Leave blank and emails print in the terminal that is running the app.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Claude matches unlisted "Something else" jobs to the cost library.
# If Claude is missing or the call fails, the app tries OpenAI, then keywords.
# Neither model sets the price.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI. Listed rate-sheet jobs use this for a short note and a license flag.
# It is also the fallback for unlisted jobs when Claude is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PayPal standard checkout. Leave blank and the Pay button records a demo payment.
# Use sandbox until you are ready to take real money. Then set PAYPAL_ENV=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Road miles. Leave both blank and travel uses straight-line distance times the road factor (1.25 unless you change it).
# OpenRouteService is the free option to turn on first. OSRM is only if you have your own server.
ORS_API_KEY=
OSRM_BASE_URL=
